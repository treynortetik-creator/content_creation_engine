# ContentMultiplier Environment Configuration
# Copy this file to .env and fill in your values
#
# QUICK START (Local Mac Development):
# 1. Copy this file: cp .env.example .env
# 2. Add at minimum ONE of: OPENROUTER_API_KEY or ANTHROPIC_API_KEY
# 3. Generate a SECRET_KEY (see below)
# 4. Run: ./run_local.sh
#
# NOTE: Video/audio transcription requires GEMINI_API_KEY
#       Text files (.txt, .md) work without Gemini

# ===========================================
# REQUIRED API KEYS (at least one needed)
# ===========================================

# Option 1: OpenRouter API Key (RECOMMENDED - easiest setup)
# Get from: https://openrouter.ai/
# Provides access to multiple AI models through one API
OPENROUTER_API_KEY=your_openrouter_key_here

# Option 2: Anthropic API Key (direct Claude access)
# Get from: https://console.anthropic.com/
# Use this for direct Claude API access
ANTHROPIC_API_KEY=

# Set to true to force OpenRouter even if Anthropic key is set
USE_OPENROUTER=false

# ===========================================
# GEMINI API KEY (for video/audio processing)
# ===========================================

# Google AI Studio API Key (for Gemini models)
# Get from: https://aistudio.google.com/
#
# REQUIRED FOR:
# - Video transcription (.mp4, .mov, .avi, .webm, .mkv)
# - Audio transcription (.mp3, .wav, .m4a, .ogg, .flac)
# - PDF text extraction with image analysis
# - DOCX with embedded images
#
# NOT REQUIRED FOR:
# - Plain text files (.txt, .md)
# - Text-only content processing
GEMINI_API_KEY=your_gemini_key_here

# ===========================================
# SECURITY
# ===========================================

# Secret key for JWT token signing
# IMPORTANT: Generate a secure key for production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_in_production

# ===========================================
# DATABASE
# ===========================================

# Database path (SQLite with async support)
# Default location works for local development
DATABASE_URL=sqlite+aiosqlite:///./database/contentmultiplier.db

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Debug mode (set to false in production)
DEBUG=true

# Maximum upload file size in MB
UPLOAD_MAX_SIZE_MB=500

# Environment mode: development or production
ENVIRONMENT=development

# ===========================================
# ADMIN CREDENTIALS
# ===========================================

# Admin dashboard access (/admin)
# CHANGE THESE IN PRODUCTION!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_change_this

# ===========================================
# RATE LIMITING (OPTIONAL)
# ===========================================

# Maximum uploads per user per hour (default: 10)
# RATE_LIMIT_UPLOADS=10

# ===========================================
# LOCAL DEVELOPMENT NOTES
# ===========================================
#
# To run locally on Mac:
#   ./run_local.sh
#
# This will:
# 1. Create a virtual environment
# 2. Install dependencies
# 3. Start the server on http://localhost:5000
#
# The app will work with just an OpenRouter or Anthropic key,
# but video/audio features need a Gemini key.
